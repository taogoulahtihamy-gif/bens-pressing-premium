generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  address      String
  service      String
  clothes      String
  instructions String?
  pickupDate   String
  pickupTime   String
  totalPrice   Float
  status       String   @default("pending")
  trackingCode String   @unique
  createdAt    DateTime @default(now())
}
